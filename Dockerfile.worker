FROM --platform=$BUILDPLATFORM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS build

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY cmd ./cmd
COPY db ./db
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
    go build -mod=readonly -trimpath -buildvcs=false -ldflags="-s -w" \
    -o /out/watchtrace-worker ./cmd/worker && \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
    go build -mod=readonly -trimpath -buildvcs=false -ldflags="-s -w" \
    -o /out/watchtrace-healthcheck ./cmd/healthcheck && \
    mkdir -p /out/worker-data

FROM scratch

LABEL org.opencontainers.image.title="WatchTrace Hosted Worker" \
      org.opencontainers.image.description="Database-free WatchTrace hosted check worker" \
      org.opencontainers.image.source="https://github.com/watchtrace/watchtrace-platform"

COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build --chown=65532:65532 /out/watchtrace-worker /watchtrace-worker
COPY --from=build --chown=65532:65532 /out/watchtrace-healthcheck /watchtrace-healthcheck
COPY --from=build --chown=65532:65532 /out/worker-data /var/lib/watchtrace-worker

VOLUME ["/var/lib/watchtrace-worker"]
USER 65532:65532
EXPOSE 8090
STOPSIGNAL SIGTERM

ENTRYPOINT ["/watchtrace-worker"]
