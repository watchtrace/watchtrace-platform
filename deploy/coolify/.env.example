WATCHTRACE_CONTROL_IMAGE=ghcr.io/watchtrace/watchtrace-platform:main
WATCHTRACE_WORKER_IMAGE=ghcr.io/watchtrace/watchtrace-worker:main

POSTGRES_USER=watchtrace
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=watchtrace
WATCHTRACE_DATABASE_URL=postgres://watchtrace:replace-with-the-same-password@postgres:5432/watchtrace?sslmode=disable

WATCHTRACE_PUBLIC_URL=https://watchtrace.org
WATCHTRACE_SMTP_ADDRESS=smtp.email.ap-mumbai-1.oci.oraclecloud.com:587
WATCHTRACE_SMTP_USERNAME=replace-with-oci-smtp-username
WATCHTRACE_SMTP_PASSWORD=replace-with-oci-smtp-password
WATCHTRACE_EMAIL_FROM=watchtrace@example.com

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-private-phase-access-key
AWS_SECRET_ACCESS_KEY=replace-with-private-phase-secret-key
# Leave empty for the owner-only Phase 1 runtime identity. The `prod` resource
# label does not make this a customer-ready production credential model. If
# temporary credentials are used, update all three values before the token expires.
AWS_SESSION_TOKEN=
WATCHTRACE_SQS_HOSTED_JOB_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/watchtrace-prod-check-jobs-hosted.fifo
WATCHTRACE_SQS_HOSTED_JOB_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/watchtrace-prod-check-jobs-hosted-dlq.fifo
WATCHTRACE_SQS_RESULT_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/watchtrace-prod-check-results.fifo
WATCHTRACE_SQS_RESULT_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/watchtrace-prod-check-results-dlq.fifo

WATCHTRACE_PLATFORM_SIGNING_KEY_ID=platform-v1
WATCHTRACE_MONITOR_HEADER_KEY_VERSION=1
WATCHTRACE_WORKER_ENCRYPTION_KEY_ID=enc-v1
WATCHTRACE_RESULT_KEY_ID=result-v1
WATCHTRACE_WORKER_POOL_ID=hosted
WATCHTRACE_WORKER_ID=hosted-worker-1
WATCHTRACE_NOTIFICATION_WORKER_ID=notification-worker-1

# No deployment key value is a Coolify environment variable. Generate all six
# runtime key files under /data/watchtrace/keyset on the Oracle host by
# following README.md.
