# Local development only. Copy this file to .env and replace the placeholder
# with the same local-only password used in deploy/local/postgres.env.
WATCHTRACE_DATABASE_URL=postgres://watchtrace_dev:replace-with-the-same-local-password@127.0.0.1:5432/watchtrace_dev?sslmode=disable
WATCHTRACE_ENVIRONMENT=development
WATCHTRACE_HTTP_ADDRESS=127.0.0.1:8080
WATCHTRACE_SHUTDOWN_TIMEOUT=10s
