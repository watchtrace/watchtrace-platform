# Local development only. Copy this file to .env and replace the placeholder
# with the same local-only password used in deploy/local/postgres.env.
WATCHTRACE_DATABASE_URL=postgres://watchtrace_dev:replace-with-the-same-local-password@127.0.0.1:5432/watchtrace_dev?sslmode=disable
WATCHTRACE_ENVIRONMENT=development
WATCHTRACE_HTTP_ADDRESS=127.0.0.1:8080
WATCHTRACE_SHUTDOWN_TIMEOUT=10s
WATCHTRACE_VERIFICATION_PROVIDER=local
WATCHTRACE_VERIFICATION_SMTP_ADDRESS=127.0.0.1:1025
WATCHTRACE_VERIFICATION_FROM=watchtrace@localhost
WATCHTRACE_VERIFICATION_URL=http://127.0.0.1:3000/verify-email
WATCHTRACE_PASSWORD_RESET_URL=http://127.0.0.1:3000/reset-password
WATCHTRACE_INVITATION_URL=http://127.0.0.1:3000/accept-invitation
# For OCI Email Delivery set the verification provider to oci, use its regional
# SMTP endpoint, and inject WATCHTRACE_VERIFICATION_SMTP_USERNAME and
# WATCHTRACE_VERIFICATION_SMTP_PASSWORD from secret storage. Never commit them.
# Durable incident notifications use the local Mailpit SMTP listener by default.
WATCHTRACE_NOTIFICATION_PROVIDER=local
WATCHTRACE_NOTIFICATION_SMTP_ADDRESS=127.0.0.1:1025
WATCHTRACE_NOTIFICATION_FROM=watchtrace@localhost
WATCHTRACE_NOTIFICATION_WORKER_ID=notification-worker-1
# For OCI Email Delivery set the provider to oci, use its regional SMTP
# endpoint, and inject WATCHTRACE_NOTIFICATION_SMTP_USERNAME and
# WATCHTRACE_NOTIFICATION_SMTP_PASSWORD from secret storage. Never commit them.
# Development only. Production must inject a random base64-encoded 32-byte key.
WATCHTRACE_MONITOR_HEADER_KEY=V2F0Y2hUcmFjZS1kZXYtaGVhZGVyLWtleS0wMDAwMSE=
WATCHTRACE_MONITOR_HEADER_KEY_VERSION=1
# Development uses the process-local fallback key. Generate a distinct Ed25519
# key for every deployed environment and inject its base64-encoded 64-byte
# private key without committing it to this file.
WATCHTRACE_PLATFORM_SIGNING_KEY_ID=platform-v1
# LocalStack only. Production omits this and uses the AWS SDK default chain.
WATCHTRACE_SQS_ENDPOINT=http://127.0.0.1:4566
AWS_REGION=ap-south-1
# Runtime queue URLs come from the verified environment manifest.
WATCHTRACE_SQS_HOSTED_JOB_QUEUE_URL=http://127.0.0.1:4566/000000000000/watchtrace-dev-check-jobs-hosted.fifo
WATCHTRACE_SQS_HOSTED_JOB_DLQ_URL=http://127.0.0.1:4566/000000000000/watchtrace-dev-check-jobs-hosted-dlq.fifo
WATCHTRACE_SQS_RESULT_QUEUE_URL=http://127.0.0.1:4566/000000000000/watchtrace-dev-check-results.fifo
WATCHTRACE_SQS_RESULT_DLQ_URL=http://127.0.0.1:4566/000000000000/watchtrace-dev-check-results-dlq.fifo
# Base64 key files are generated locally/deployed from secret storage and are ignored by Git.
WATCHTRACE_QUARANTINE_KEY=./local-secrets/quarantine.key
